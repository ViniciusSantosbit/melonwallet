{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/server.js"
        },
        {
            "source": "/((?:css|js|images|icons|assets|public)/(?:.*)|.*\\.(?:css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|json|map))",
            "destination": "/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/server.js"
        }
    ]
}
